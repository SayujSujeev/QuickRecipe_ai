rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /familyMembers/{memberId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Shared recipe library imported from TheMealDB. Readable/writable by
    // any signed-in user; there's no per-user ownership on these docs.
    match /recipes/{recipeId} {
      allow read, write: if request.auth != null;
    }

    // Recipe-reel import jobs and drafts are written only by trusted Cloud
    // Functions (Admin SDK bypasses rules). Clients may only read their own
    // jobs/drafts for status polling and review, and submit corrections.
    match /recipeImportJobs/{jobId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if false;
    }

    match /recipeDrafts/{draftId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if false;
    }

    match /recipeDraftCorrections/{correctionId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if false;
    }
  }
}
