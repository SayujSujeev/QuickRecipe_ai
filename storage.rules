rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Temporary import media: only the owning user's client may PUT an
    // upload here (used for the local-video-upload fallback path); all
    // reads/deletes happen server-side via the Admin SDK, which bypasses
    // these rules. Clients never read raw video/audio/frames back.
    match /recipeImports/{userId}/{jobId}/{fileName} {
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 150 * 1024 * 1024;
      allow read: if false;
    }

    // Generated recipe thumbnails are immutable cookbook assets. Tokenized
    // download URLs are used by Image.network; authenticated reads also make
    // recovery possible if a token ever needs to be rotated.
    match /recipeThumbnails/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
