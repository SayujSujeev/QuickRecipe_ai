# Server-only secrets for Cloud Functions. NEVER commit the real .env or
# ship any of these values to the Flutter client. In production these are
# set via `firebase functions:secrets:set OPENAI_API_KEY` (Secret Manager),
# not via this file — this file is for the local emulator only.

OPENAI_API_KEY=sk-your-key-here

OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_RECIPE_MODEL=gpt-5.6-luna
OPENAI_RECIPE_REASONING_EFFORT=low
OPENAI_RECIPE_MAX_OUTPUT_TOKENS=3000
OPENAI_RECIPE_FALLBACK_MODEL=

IMPORT_MAX_VIDEO_DURATION_SECONDS=180
IMPORT_MAX_UPLOAD_BYTES=157286400
IMPORT_TEMP_RETENTION_SECONDS=3600
IMPORT_TEMP_HARD_CLEANUP_SECONDS=86400
IMPORT_MAX_CONCURRENT_JOBS_PER_USER=2
IMPORT_MAX_DAILY_IMPORTS_PER_USER=20
IMPORT_CONFIDENCE_REVIEW_THRESHOLD=0.80

# Cloud Tasks queue used to dispatch the media worker.
RECIPE_IMPORT_TASK_QUEUE=recipe-import-processing
GCLOUD_PROJECT=cooksense-c34d5
FUNCTIONS_REGION=us-central1
